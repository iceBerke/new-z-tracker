<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ztracker</groupId>
    <artifactId>ZTracker_Fiji</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>ZTracker Fiji Plugin</name>
    <description>3D Z-coordinate extraction plugin for Fiji/ImageJ</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <patch.version>p11.1</patch.version>
    </properties>

    <repositories>
        <repository>
            <id>scijava</id>
            <url>https://maven.scijava.org/content/groups/public</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>net.imagej</groupId>
            <artifactId>ij</artifactId>
            <version>1.54f</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Explicit compiler plugin config takes precedence over IntelliJ's
                 injected source/target flags. release=8 targets Fiji's JVM. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>8</release>
                    <encoding>UTF-8</encoding>
                    <compilerArgs>
                        <arg>-Xlint:-options</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Tests run in TWO surefire executions, and the split is the point (p10.14).
                 ProjectionStackScannerMemoryTest asserts Tool 1's TIFF-stack input still reads
                 slices one at a time instead of loading the whole timepoint. That is a memory
                 property, and the only thing that can prove it is a heap too small for the
                 forbidden design: the fixture is 400 MiB held as float[][] per slice but 13 MiB
                 streamed, so -Xmx96m passes only if the streaming design is intact. Without the
                 cap the test asserts nothing at all: a load-all refactor produces identical
                 numbers and would pass. surefire cannot vary -Xmx per test class within one
                 execution, hence the second one.

                 Declaring this plugin PINS surefire at 3.2.5, which is what the super-POM
                 default already resolved to here - a deliberate consequence of having to
                 declare it, not an incidental version bump. Nothing else about the main
                 execution changes; it runs every test it ran before, minus the one class the
                 other execution owns.

                 "Tests run:" therefore prints twice - see CLAUDE.md's rule on taking test
                 counts from a clean run, which now sums the two executions. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <exclude>**/ProjectionStackScannerMemoryTest.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>streaming-invariant-test</id>
                        <phase>test</phase>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <includes>
                                <include>**/ProjectionStackScannerMemoryTest.java</include>
                            </includes>
                            <!-- The assertion itself. Do not raise this: the load-all design
                                 needs 400 MiB, over 4x this cap (measured: it dies after 22 of
                                 the 100 slices), while the streaming design peaks near 13 MiB.
                                 Raising the cap silently retires the guard. -->
                            <argLine>-Xmx96m</argLine>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Package as a fat jar so Fiji can load it as a single file -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                    <finalName>z-tracker-v4-${patch.version}</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                    <attach>false</attach>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Suppress the default thin JAR and the local-repo install step.
                 This is a Fiji plugin, not a library — no local Maven repo install needed. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.1.2</version>
                <executions>
                    <execution>
                        <id>default-install</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- Auto-deploy: copies jar to local Fiji plugins folder on mvn install.
                 Path is machine-specific (berke.santos desktop install). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-to-fiji</id>
                        <phase>install</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>C:/Users/berke.santos/Desktop/Fiji-Stable/plugins</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>z-tracker-v4-${patch.version}.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Post-install verification: fails the build if the fat JAR was not
                 created in target/ or not copied to the Fiji plugins folder. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Remove superseded versions of this plugin's JAR from the Fiji
                         plugins folder, so a version bump doesn't leave the old JAR behind
                         (which would make Fiji register the plugin twice). Excludes the
                         current version, so it is safe to run after copy-to-fiji — it can
                         never delete the freshly-built JAR.

                         failonerror="false" is deliberate: it keeps one undeletable file from
                         aborting the sweep over the others. The cost is that a failure here is
                         silent — and note Ant logs "[delete] Deleting <file>" as its *intent*,
                         so that line is NOT proof the file went. verify-deploy below is what
                         actually enforces the outcome; do not rely on this step alone. -->
                    <execution>
                        <id>clean-old-jars</id>
                        <phase>install</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <delete failonerror="false" verbose="true">
                                    <fileset dir="C:/Users/berke.santos/Desktop/Fiji-Stable/plugins"
                                             includes="z-tracker-v4-*.jar"
                                             excludes="z-tracker-v4-${patch.version}.jar"/>
                                </delete>
                                <echo level="info" message="[clean-old-jars] Attempted removal of any z-tracker-v4-*.jar except the current z-tracker-v4-${patch.version}.jar (verify-deploy confirms)."/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-deploy</id>
                        <phase>install</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <available file="${project.build.directory}/z-tracker-v4-${patch.version}.jar"
                                           property="fat.jar.exists"/>
                                <fail unless="fat.jar.exists"
                                      message="FAT JAR not found in target/. Did mvn package run?"/>
                                <available file="C:/Users/berke.santos/Desktop/Fiji-Stable/plugins/z-tracker-v4-${patch.version}.jar"
                                           property="fiji.jar.exists"/>
                                <fail unless="fiji.jar.exists"
                                      message="JAR not copied to Fiji plugins folder. Check the &lt;outputDirectory&gt; of the copy-to-fiji execution in pom.xml."/>
                                <!-- "the new JAR is there" is not the same as "the old one is gone".
                                     clean-old-jars cannot fail the build (see its comment), so a
                                     superseded JAR held open by a running Fiji survives silently and
                                     Fiji then registers every ZTracker tool twice. Assert the folder
                                     really holds only the current version. -->
                                <pathconvert property="stale.jars" pathsep=", " setonempty="false">
                                    <fileset dir="C:/Users/berke.santos/Desktop/Fiji-Stable/plugins"
                                             includes="z-tracker-v4-*.jar"
                                             excludes="z-tracker-v4-${patch.version}.jar"/>
                                    <mapper type="flatten"/>
                                </pathconvert>
                                <fail if="stale.jars"
                                      message="Superseded JAR(s) still in the Fiji plugins folder: ${stale.jars} — they could not be deleted, almost always because Fiji is running and holds them open (Windows file lock). Leaving them there makes Fiji register every ZTracker tool twice. Quit Fiji completely, then re-run mvn install."/>
                                <echo level="info" message="[verify-deploy] OK — z-tracker-v4-${patch.version}.jar built and deployed, and no superseded z-tracker-v4-*.jar left behind."/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
