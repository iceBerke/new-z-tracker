# ZTracker Fiji Plugin
# This file tells Fiji to register the plugin in the Plugins menu.
# Format: Plugins > Submenu, "Menu Label", ClassName

# Registered in pipeline order (produce -> extract): Z-Projection (Tool 1),
# then the two extractors (Tool 2 indexed, Tool 3 TopoJ / direct-Z).
Plugins>ZTracker, "Z-Projection + Origin Map", ztracker.projector.ZProjectorPlugin
Plugins>ZTracker, "3D Z-Coordinate Extractor", ztracker.extractor.ZTrackerPlugin
Plugins>ZTracker, "3D Z-Extractor (TopoJ / direct-Z)", ztracker.topoj.TopoJTrackerPlugin
